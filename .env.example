# Canonical origin for the deployed site.
# Used by metadataBase, canonical URLs, Open Graph tags, sitemap.xml and
# robots.txt. Leave unset locally; set it in the deployment environment so
# none of those surfaces emit localhost URLs.
# Example: https://baitticreativestudio.com
NEXT_PUBLIC_SITE_URL=

# Booking link used by every "Book a fit call" CTA.
# While this is blank the CTAs fall back to the on-page booking section
# (/#contact) rather than pointing at a booking URL that does not exist yet.
NEXT_PUBLIC_BOOKING_LINK=

# Contact email shown in the footer.
# While this is blank the footer renders a visible [PENDING: contact email]
# placeholder instead of a fake mailto address.
NEXT_PUBLIC_CONTACT_EMAIL=

# Endpoint the inquiry form POSTs to (form service URL or serverless route).
# While this is blank the form stays in local-only mode: it still validates
# input and shows its success state, but sends nothing anywhere.
NEXT_PUBLIC_FORM_ENDPOINT=

# Optional analytics. The scripts only load when these are set.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
